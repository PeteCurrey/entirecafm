{
  "name": "ClientFeedback",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comments": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "type": "string",
      "description": "ClientUser ID"
    }
  },
  "required": [
    "client_id",
    "job_id",
    "rating",
    "submitted_at"
  ]
}