{
  "name": "ClientPortalTheme",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "default": "#E1467C"
    },
    "accent_color": {
      "type": "string",
      "default": "#27B3F7"
    },
    "welcome_text": {
      "type": "string"
    },
    "portal_slug": {
      "type": "string",
      "description": "URL slug for client portal"
    }
  },
  "required": [
    "org_id",
    "client_id"
  ]
}