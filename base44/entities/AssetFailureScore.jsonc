{
  "name": "AssetFailureScore",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "risk_score": {
      "type": "number",
      "description": "0-1, where 1 is highest risk"
    },
    "risk_band": {
      "type": "string",
      "enum": [
        "LOW",
        "MED",
        "HIGH"
      ]
    },
    "rul_days": {
      "type": "number",
      "description": "Remaining useful life in days"
    },
    "top_drivers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Top risk contributors"
    },
    "next_ppm_recommendation_days": {
      "type": "number"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    },
    "model_version": {
      "type": "string",
      "default": "v1.0-rules"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "org_id",
    "asset_id",
    "risk_score",
    "risk_band"
  ]
}